# The published 0.0.1-rc.1 line of @deepseek-ai/dsh-session peers on
# @deepseek-ai/dsh-type-meta, which is not published to the npm registry.
# Dev-time resolution of @deepseek-ai/* comes from the sibling harness
# checkout through tsconfig paths (see vitest.config.ts), so peers do not
# need to be auto-installed here. The dsh runtime supplies them at load time.
auto-install-peers=false
strict-peer-dependencies=false
